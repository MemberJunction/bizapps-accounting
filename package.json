{
  "name": "bizapps-accounting",
  "private": true,
  "version": "1.0.0",
  "license": "BUSL-1.1",
  "description": "BizApps Accounting - AR subsidiary ledger of record and journal entry primitives built on MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n\u274c Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\"",
    "build": "pnpm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/accounting-entities\" --filter=\"@mj-biz-apps/accounting-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/accounting-*\"",
    "test": "turbo --log-order=stream --continue test test:dom test:types --filter=\"@mj-biz-apps/accounting-*\" --filter=!@mj-biz-apps/accounting-integration-tests",
    "mj": "mj",
    "mj:migrate": "mj migrate --schema __mj_BizAppsAccounting --dir ./migrations",
    "mj:codegen": "mj codegen",
    "install:deps": "pnpm install",
    "setup": "echo 'Please run: pnpm run mj:migrate && pnpm run mj:codegen && pnpm run build'",
    "change": "changeset",
    "version": "changeset version",
    "version:prepare": "changeset version && node ci/sync-mj-app-version.mjs && pnpm install --lockfile-only",
    "db:rebuild": "scripts/rebuild-db.sh",
    "demo:load": "mj sync push --dir demo-data",
    "test:integration": "node test-harnesses/integration.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-accounting"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "^6.1.5",
    "beasties": "0.3.5",
    "mrmime": "2.0.1",
    "rolldown": "1.0.0-beta.58",
    "rollup": "^4.43.0",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
