{
  "name": "bizapps-accounting",
  "private": true,
  "version": "1.0.0",
  "license": "BUSL-1.1",
  "description": "BizApps Accounting - AR subsidiary ledger of record and journal entry primitives built on MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n❌ Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\"",
    "build": "pnpm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/accounting-entities\" --filter=\"@mj-biz-apps/accounting-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/accounting-*\"",
    "mj": "mj",
    "mj:migrate": "mj migrate --schema __mj_BizAppsAccounting --dir ./migrations",
    "mj:codegen": "mj codegen",
    "install:deps": "pnpm install",
    "setup": "echo 'Please run: pnpm run mj:migrate && pnpm run mj:codegen && pnpm run build'",
    "change": "changeset",
    "version": "changeset version",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs",
    "db:rebuild": "scripts/rebuild-db.sh",
    "test:integration": "node test-harnesses/integration.mjs",
    "db:append-codegen": "scripts/append-codegen.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-accounting"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "6.1.0-edge.3",
    "beasties": "0.3.5",
    "mrmime": "2.0.1",
    "rolldown": "1.0.0-beta.58",
    "rollup": "^4.43.0",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@angular/animations": "21.1.3",
      "@angular/build": "21.1.3",
      "@angular/cli": "21.1.3",
      "@angular/common": "21.1.3",
      "@angular/compiler": "21.1.3",
      "@angular/compiler-cli": "21.1.3",
      "@angular/core": "21.1.3",
      "@angular/forms": "21.1.3",
      "@angular/localize": "21.1.3",
      "@angular/platform-browser": "21.1.3",
      "@angular/platform-browser-dynamic": "21.1.3",
      "@angular/router": "21.1.3",
      "@angular-devkit/build-angular": "21.1.3",
      "@memberjunction/core": "6.1.0-edge.3",
      "@memberjunction/global": "6.1.0-edge.3"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
