{
  "version": "1.0.0",
  "push": {
    "autoCreateMissingRecords": true
  },
  "directoryOrder": [
    "entities",
    "entity-fields",
    "currencies",
    "journal-entry-types",
    "gl-account-roles",
    "finance-exception-types",
    "remote-operation-categories",
    "remote-operations",
    "api-scopes",
    "api-application-scopes",
    "applications",
    "action-categories",
    "actions",
    "entity-actions",
    "entity-relationships",
    "scheduled-jobs",
    "record-processes",
    "ml-training-pipelines",
    "ml-models",
    "ml-model-scoring-bindings",
    "query-categories",
    "queries",
    "authorizations",
    "roles",
    "entity-permissions",
    "authorization-roles"
  ],
  "sqlLogging": {
    "enabled": true,
    "outputDirectory": "./sql_logging",
    "filterPatterns": [
      "*spCreateAIPromptRun*",
      "*spUpdateAIPromptRun*"
    ],
    "filterType": "exclude",
    "formatAsMigration": false
  },
  "emitSyncNotes": false
}
