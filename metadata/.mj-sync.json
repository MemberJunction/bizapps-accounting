{
  "version": "1.0.0",
  "push": {
    "autoCreateMissingRecords": true
  },
  "directoryOrder": [
    "entities",
    "currencies",
    "journal-entry-types",
    "gl-account-roles",
    "applications",
    "action-categories",
    "actions",
    "entity-actions"
  ],
  "sqlLogging": {
    "enabled": true,
    "outputDirectory": "./sql_logging",
    "filterPatterns": [
      "*spCreateAIPromptRun*",
      "*spUpdateAIPromptRun*"
    ],
    "filterType": "exclude",
    "formatAsMigration": false
  },
  "emitSyncNotes": false
}