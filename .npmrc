# pnpm settings for this repo, matching bizapps-common (the proven Open App
# workspace baseline).
#
# package-manager-strict: allows pnpm to run in a tree whose packageManager field
#   may disagree (e.g. when this repo is linked as a member of an MJ 6.x checkout
#   alongside repos that still pin npm).
# strict-peer-dependencies: peer mismatches warn instead of failing. The estate
#   straddles 6.1.0-edge.0 and 6.1.0-edge.1 peer pins, so mismatches are expected.
# auto-install-peers: pnpm's default; stated explicitly because turning it off
#   stops declared peers being available at build time.
#
# Any stray `npm` command will print "Unknown project config" for these lines —
# that is npm not recognising pnpm settings, not breakage.
package-manager-strict=false
strict-peer-dependencies=false
auto-install-peers=true
