{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [
        "build/**",
        "dist/**"
      ],
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "persistent": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": false
    },
    "test:dom": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": false
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
